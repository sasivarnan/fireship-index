{
  "name": "fireship-index",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A satirical index of Fireship's AI coverage, rendered with Astro on Vercel.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-build.mjs",
    "typecheck": "astro check",
    "lint": "oxlint src tests scripts astro.config.mjs --deny warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:built",
    "test:runtime": "node scripts/check-runtime.mjs",
    "preview": "node --env-file-if-exists=.env scripts/serve-build.mjs",
    "test:built": "node scripts/check-built-feed.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "undici": "6.29.1"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.22",
    "@fontsource/barlow-condensed": "5.3.0",
    "@vercel/blob": "2.9.0",
    "astro": "7.4.11",
    "fast-xml-parser": "5.12.0",
    "fast-xml-validator": "1.4.2"
  },
  "packageManager": "pnpm@12.18.0"
}
