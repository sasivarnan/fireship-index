{
  "name": "fireship-index",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A satirical index of Fireship's AI coverage, rendered with Astro on Cloudflare Workers.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "typecheck": "wrangler types && astro check",
    "lint": "oxlint src tests scripts astro.config.mjs --deny warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "deploy": "wrangler deploy",
    "test:runtime": "node scripts/check-runtime.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "wrangler": "4.160.1"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.7",
    "@fontsource/barlow-condensed": "5.3.0",
    "astro": "7.4.11",
    "fast-xml-parser": "5.12.0",
    "fast-xml-validator": "1.4.2"
  },
  "packageManager": "pnpm@12.18.0"
}
