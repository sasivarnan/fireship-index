---
import type { calculateIndex } from "../index.ts";
import type { FeedSnapshot } from "../lib/feed-service.ts";
import { sampleSummary, feedLine, checkedTime } from "../lib/presentation.ts";
import VideoGrid from "./VideoGrid.astro";
interface Props {
  index: ReturnType<typeof calculateIndex>;
  snapshot: FeedSnapshot | null;
}
const { index, snapshot } = Astro.props;
const missing = index.sample.filter(
  (video) => !video.description.trim(),
).length;
const checked = snapshot ? checkedTime(snapshot.fetchedAt) : "";
const [beforeChecked, afterChecked] = snapshot
  ? feedLine(index, snapshot.fetchedAt, snapshot.stale, missing).split(checked)
  : [];
---

<section aria-labelledby="videos-title">
  <div class="list-heading">
    <h2 id="videos-title">Recent videos</h2>
    <form id="refresh-form" action="/" method="get">
      <button id="refresh" type="submit">
        <span aria-hidden="true">↻</span> Refresh
      </button>
    </form>
  </div>
  <p id="sample-summary" class="muted">
    {sampleSummary(index)}
  </p>
  <p
    id="feed-status"
    class="feed-status"
    role="status"
    aria-live="polite"
    data-fetched-at={snapshot?.fetchedAt}
    data-state={snapshot ? (snapshot.stale ? "saved" : "ready") : "error"}
    data-stale={snapshot?.stale ? "true" : "false"}
  >
    {snapshot ? (
      <>
        {beforeChecked}
        <time
          data-checked-time
          datetime={new Date(snapshot.fetchedAt).toISOString()}
        >
          {checked}
        </time>
        {afterChecked}
      </>
    ) : (
      "No reading yet. Fireship’s feed is unavailable. Try Refresh, or import XML under About the index."
    )}
  </p>
  <VideoGrid index={index} />
</section>
