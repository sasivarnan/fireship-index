---
import type { calculateIndex } from "../index.ts";
import { videoPresentation } from "../lib/video-presentation.ts";
interface Props {
  index: ReturnType<typeof calculateIndex>;
}
const { index } = Astro.props;
const cards = index.classifications.map(videoPresentation);
---

<ol id="video-list" class="video-grid" role="list" aria-busy="false">
  {cards.map((card) => (
    <li class="video-card">
      <a
        class="video-link"
        href={card.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <img {...card.thumbnail} />
        <span>{card.title}</span>
      </a>
      <div class="video-meta">
        <time datetime={card.published}>{card.date}</time>
        {card.matched ? (
          <div class="video-match">
            <button
              type="button"
              class="match-trigger"
              aria-describedby={card.tooltipId}
            >
              <span class="match-dot" aria-hidden="true"></span>AI match
            </button>
            <p class="video-evidence" id={card.tooltipId} role="tooltip">
              {card.evidence}
            </p>
          </div>
        ) : (
          <p class="no-match">No AI match</p>
        )}
      </div>
    </li>
  ))}
</ol>
