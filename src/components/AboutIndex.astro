---
import type { calculateIndex } from "../index.ts";
import { samplePeriod } from "../lib/presentation.ts";
interface Props {
  index: ReturnType<typeof calculateIndex>;
}
const { index } = Astro.props;
---

<section id="method" class="about" aria-labelledby="about-title">
  <h2 id="about-title">About the index</h2>
  <div class="about-grid">
    <div>
      <h3>The signal</h3>
      <p>
        Titles and descriptions from up to 15 recent uploads are checked for AI
        terms. Keyword checks can miss context.
      </p>
    </div>
    <div>
      <h3>The score</h3>
      <p>
        60% AI coverage, 40% posting pace. More AI uploads, more often, means a
        higher score.
      </p>
    </div>
    <div>
      <h3>The joke</h3>
      <p>
        Satire, not a forecast of job losses or extinction. Independent and not
        affiliated with Fireship.
      </p>
    </div>
  </div>
  <p class="about-source">
    Source:{" "}
    <a
      href="https://www.youtube.com/feeds/videos.xml?channel_id=UCsBjURrPoezykLs9EqgamOA"
      target="_blank"
      rel="noopener noreferrer"
    >
      YouTube RSS
    </a>
    . Cached for 15 minutes. The last valid feed stays available during outages.
  </p>
  <p id="sample-period" class="about-period">
    {samplePeriod(index)}
  </p>
</section>
