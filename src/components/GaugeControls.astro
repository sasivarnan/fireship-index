<button
  id="gauge-replay"
  class="gauge-control replay-control"
  type="button"
  aria-label="Replay gauge animation"
  hidden
>
  <span class="control-label" aria-hidden="true">
    Replay
  </span>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 9a8 8 0 1 1-1 7M5 3v6h6" />
  </svg>
</button>
<a
  class="scroll-cue"
  href="#recent-videos"
  aria-label="Scroll to recent videos"
>
  <svg viewBox="0 0 32 38" aria-hidden="true">
    <path d="M16 3v27M5 20l11 12 11-12" />
  </svg>
</a>
<button
  id="gauge-pause"
  class="gauge-control pause-control"
  type="button"
  aria-label="Pause animations"
  aria-pressed="false"
  hidden
>
  <span class="control-label" aria-hidden="true">
    <span class="pause-label">Pause</span>
    <span class="resume-label">Resume</span>
  </span>
  <svg class="pause-symbol" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M8 5v14M16 5v14" />
  </svg>
  <svg class="play-symbol" viewBox="0 0 24 24" aria-hidden="true">
    <path d="m8 5 11 7-11 7Z" />
  </svg>
</button>
